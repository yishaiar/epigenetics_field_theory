{
  "permissions": {
    "allow": [],
    "deny": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/plan-skill-gate.sh"
          }
        ]
      }
    ],
    "_disabled_PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/secret-scan-on-commit.sh"
          }
        ]
      }
    ],

    
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/format-on-save.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/lint-on-save.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/pyright-on-save.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/debug-artifact-on-save.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/test-on-spec-save.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/notify-on-stop.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/cold-eye-reminder.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/plan-mode-enforce-skill.sh"
          }
        ]
      }
    ]
  }
}
