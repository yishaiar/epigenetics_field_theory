# Copy this file to .env for local environment settings.
# Leave RUN_DATE blank to use the current date in ddmmyy format.
RUN_DATE=
# Set to true to run notebooks against the generated 1,700-cell demo fixture.
DEMO_MODE=false
# Set to true to skip batch correction in Notebook 2.
skip_batch_correction=True
# Balancing reads the sampling seed from app/config/.env.
RANDOM_STATE=42
# Set to true to generate every UMAP marker-staining plot in Notebook 3.
PLOT_ALL_UMAP_STAINING=true
